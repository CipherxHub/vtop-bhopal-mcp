# VTOP Base URL (default: https://vtop.vitbhopal.ac.in/vtop)
# Bhopal (this fork's target): https://vtop.vitbhopal.ac.in/vtop
# VIT Vellore / Chennai: https://vtop.vit.ac.in/vtop
# VIT-AP: https://vtop.vitap.ac.in/vtop
VTOP_BASE_URL=https://vtop.vitbhopal.ac.in/vtop

# Single-user credentials. In stdio mode and single-user HTTP mode the server
# auto-logs in with these. Also used by scripts/e2e.ts. Never logged.
VTOP_USERNAME=
VTOP_PASSWORD=

# Multi-user HTTP connector. Set CONNECTOR_SECRET to a long random string to
# turn one shared connector into a multi-user one: each user visits /register,
# enters their own VTOP credentials, and gets an encrypted token to paste into
# their ChatGPT connector's API key / Authorization field. Credentials are
# encrypted into the token (AES-256-GCM) — nothing is stored server-side.
# Rotating this secret invalidates all issued tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CONNECTOR_SECRET=

# Optional: skip the interactive semester picker
# VTOP_SEMESTER_ID=

# Optional: set to "1" to dump raw HTML responses to test-output/<run-id>/
# VTOP_DUMP_HTML=1

# Optional: TLS escape hatch for hosts behind a TLS-inspecting proxy whose CA
# is not in the OS trust store (otherwise you'd see "unable to verify the first
# certificate"). The server already merges the OS trust store into Node's CA
# list automatically; only set this if that isn't enough. WARNING: this
# disables certificate verification process-wide — use only on a trusted network.
# VTOP_INSECURE_TLS=1
